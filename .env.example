# Copy to .env.local and fill in. Never commit .env.local.

# --- Centralised inboxes (MoM item 4.4) -------------------------------------
# Addresses that receive website form submissions.
# Until the centralised IDs are supplied, both fall back to info@wesearchinc.com.
CAREERS_EMAIL=
CONTACT_EMAIL=

# --- Mail delivery ----------------------------------------------------------
# API key from https://resend.com. Without it, submissions are logged to the
# server console in development and REJECTED in production.
RESEND_API_KEY=

# Sender address. Must be on a domain verified with the mail provider.
MAIL_FROM="WeSearch Website <noreply@wesearchinc.com>"
